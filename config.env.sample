# BreakTest self-host runtime configuration
# Copy to config.env and adjust before production use.

# Image versions are pinned per service in version.env, which ships with this
# bundle and is updated by upgrades. Set BREAKTEST_VERSION here to override
# every image, for example for a rollback:
# BREAKTEST_VERSION=26.7.0
BREAKTEST_IMAGE_REGISTRY=breakingit
BREAKTEST_COMPOSE_PROJECT_NAME=breaktest

# Externally visible origin. This is the single source for application links,
# secure cookies, and external load-generator ws/wss connection settings.
BREAKTEST_PUBLIC_URL=http://localhost
# disabled: HTTP only; letsencrypt: Traefik terminates TLS; external: an
# upstream proxy terminates TLS and forwards HTTP to this stack.
BREAKTEST_TLS_MODE=disabled
LETS_ENCRYPT_EMAIL=admin@example.com
HTTP_PORT=80
# Used only when BREAKTEST_TLS_MODE=letsencrypt.
HTTPS_PORT=

# IANA timezone used by server processes and logs. install.sh detects the host
# timezone and writes it here; UTC is the safe fallback for manual installs.
TZ=UTC
LOG_LEVEL=INFO
BACKUP_PATH=./backups

# Licensing is paired from the interactive SuperAdmin License page. Official
# Selfhost images hard-code https://breaktest.io; no server URL or key belongs
# in this configuration file.
# Connected activation is completed after startup from SuperAdmin → Platform →
# License against https://breaktest.io.

# Optional AI assistant. Requires a license with ai_assistant enabled and either
# ANTHROPIC_API_KEY or both OPENAI_ACCESS_TOKEN/OPENAI_REFRESH_TOKEN.
AI_ASSISTANT_ENABLED=false
HERMES_URL=http://ai-assistant:8080
HERMES_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=
OPENAI_ACCESS_TOKEN=
OPENAI_REFRESH_TOKEN=
OPENAI_TOKEN_EXPIRES=
OPENAI_EMAIL=
AI_MODEL=

# Required secrets. start.sh replaces CHANGE_ME values on first run.
JWT_SECRET_KEY=CHANGE_ME
CREDENTIAL_ENCRYPTION_KEY=
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

# MongoDB
MONGO_DATABASE=breakingit

# TimescaleDB/PostgreSQL tuning
# Optional absolute host path for TimescaleDB data. Leave empty to use the
# project-scoped Docker volume.
POSTGRES_DATA_PATH=
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_TIMEZONE=UTC
POSTGRES_FSYNC=off
POSTGRES_SYNCHRONOUS_COMMIT=off
POSTGRES_FULL_PAGE_WRITES=on
POSTGRES_WORK_MEM=64MB

# pg-proxy
PG_PROXY_MAX_CONNS=100
PG_PROXY_MAX_INFLIGHT=512
PG_PROXY_COPY_TIMEOUT_SEC=60
PG_PROXY_MAX_BODY_BYTES=67108864

# Local load generator
LOAD_GENERATOR_TOKEN=local-token
LOAD_GENERATOR_NAME=loadgenerator
LOAD_GENERATOR_LOCATION=Local
# Test execution mode: container (preferred, isolated JMeter/K6 workloads) or
# process. start.sh verifies the Docker socket mount after pulling the image
# and falls back to process mode when container mode is not usable.
LOAD_GENERATOR_RUN_MODE=container
# Optional limit for the load generator and each child test container.
# LOAD_GENERATOR_CPU_LIMIT=4.0
# LOAD_GENERATOR_MEMORY_LIMIT=4096m
LOAD_GENERATOR_PUBLIC=false
LOAD_GENERATOR_SUPPORTS_SYNTHETIC_MONITORING=true
LOAD_GENERATOR_CUSTOMER_NAME=Default
# Comma-separated optional services: loadgenerator,ai-assistant
COMPOSE_PROFILES=loadgenerator

# Optional cloud provider settings
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_SES_REGION=eu-west-1
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SSH_PUBLIC_KEY=
AZURE_LOADGENERATOR_IMAGE=
AZURE_CONTAINER_REGISTRY_SERVER=
AZURE_CONTAINER_REGISTRY_USERNAME=
AZURE_CONTAINER_REGISTRY_PASSWORD=
AZURE_DOCKERHUB_USERNAME=
AZURE_DOCKERHUB_TOKEN=
DOP_API_TOKEN=
DOP_SSH_KEY_NAME=
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=
